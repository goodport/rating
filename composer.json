{
    "name": "goodport/rating",
    "description": "Laravel Eloquent Rating allows you to assign ratings to any model.",
    "type": "library",
    "keywords": [
        "eloquent",
        "laravel",
        "model",
        "rating",
        "rate",
        "stars",
        "star",
        "system"
    ],
    "homepage": "https://github.com/goodport/rating",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Goodport",
            "homepage": "https://github.com/goodport"
        }
    ],
    "support": {
        "issues": "https://github.com/goodport/rating/issues",
        "source": "https://github.com/goodport/rating"
    },
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "laravel/legacy-factories": "^1.3",
        "mockery/mockery": "^1.5",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "Rennokki\\Rating\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rennokki\\Rating\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rennokki\\Rating\\RatingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
